<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.cooking.dao.mapper.RecipeViewMapper">

    <resultMap id="ViewsListRespMap" type="com.example.cooking.dto.resp.ViewsListResp">
        <!-- recipe_view columns -->
        <result property="id" column="view_id"/>
        <result property="recipeId" column="recipe_id"/>

        <!-- recipe columns -->
        <result property="dishName" column="dish_name"/>
        <result property="description" column="description"/>

        <!-- JSON array: images -->
        <collection property="images" ofType="java.lang.String" column="image_url"
                    javaType="java.util.List" />
    </resultMap>

    <select id="listUserViews" resultType="com.example.cooking.dto.resp.ViewsListResp">
        SELECT
        rv.id AS id,
        rv.recipe_id AS recipeId,
        r.dish_name AS dishName,
        r.description AS description,
        (
        SELECT GROUP_CONCAT(ri.image_url ORDER BY ri.id SEPARATOR ',')
        FROM recipe_images ri
        WHERE ri.recipe_id = rv.recipe_id
        ) AS images
        FROM recipe_views rv
        LEFT JOIN recipes r ON r.id = rv.recipe_id
        WHERE rv.user_id = #{userId}
        ORDER BY rv.created_at DESC
    </select>


</mapper>
